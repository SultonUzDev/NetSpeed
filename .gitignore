# ---------------------------------------------------------------------------------------------
# Signing material — never commit
# ---------------------------------------------------------------------------------------------
# A leaked release key lets anyone sign an APK as you, and it cannot be rotated for an app that
# is already published. keystore.properties holds the store and key passwords in plaintext.
keystore/
*.jks
*.keystore
keystore.properties

# ---------------------------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------------------------
/build
build/
/captures
.gradle
.cxx
.externalNativeBuild

# Unpacked bundles and exported artifacts. Android Studio writes these when you use
# Build > Generate Signed Bundle / APK, and they are large, regenerable, and never useful in git.
/app/release/
/app/debug/
*.apk
*.aab
*.ap_
*.dex

# Kotlin incremental compilation state
.kotlin/

# ---------------------------------------------------------------------------------------------
# Local machine configuration
# ---------------------------------------------------------------------------------------------
local.properties
gradle/gradle-daemon-jvm.properties

# ---------------------------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------------------------
*.iml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deploymentTargetDropDown.xml
.idea/appInsightsSettings.xml
.idea/androidTestResultsUserPreferences.xml
.idea/misc.xml

# ---------------------------------------------------------------------------------------------
# Listing assets — sources and output are committed, working files are not
# ---------------------------------------------------------------------------------------------
# Raw device captures the video generator frames. Tens of megabytes of regenerable footage that
# git would keep forever; the finished 1080p cut (a few MB) is committed instead, and a new take
# is one screenrecord away. The still captures (samples/img*.png, samples/tab_*.png) are kept,
# since the listing images cannot be rebuilt without them.
samples/demo_raw*.mp4
samples/*.webm

# Scratch file make_demo_video.py writes while compositing and deletes on success.
samples/.demo_overlay.png

# Python bytecode from the two generator scripts
__pycache__/
*.pyc

# ---------------------------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------------------------
.DS_Store
Thumbs.db