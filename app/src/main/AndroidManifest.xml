<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Service permissions -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        specialUse, not dataSync. Android 15 caps a dataSync foreground service at roughly six
        hours per day and then stops it, which for a continuous network monitor means it simply
        dies partway through the day. Continuous measurement is not a data sync, and specialUse is
        the type the platform provides for a long-running job that fits no other category.
        Using it requires declaring the subtype below and justifying it in the Play Console.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Floating speed overlay. Special permission: granted from system settings, revocable. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Usage access: special permission, granted by the user in system settings, not at runtime.
         Unlocks NetworkStatsManager for per-app usage and system-accurate daily totals. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Package visibility. Since Android 11 getPackagesForUid() returns null for apps this one
        cannot "see", which is why the per-app usage list rendered every entry as "Unknown (uid
        NNNNN)". Declaring the launcher intent makes every user-launchable app resolvable, which
        is what the breakdown needs in order to name and illustrate its rows.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NetSpeedApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetSpeed"
        tools:targetApi="31">

        <activity
            android:name=".presentation.MainActivity"

            tools:ignore="Instantiatable"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.services.SpeedMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous measurement of network throughput and data usage for
                    display in an ongoing notification, a status bar indicator and an optional
                    floating overlay. The measurement is only meaningful while sampling is
                    uninterrupted, so it must run for as long as the user leaves it enabled." />
        </service>

        <!-- Home-screen widget. updatePeriodMillis is 0; the service pushes live updates. -->
        <receiver
            android:name=".data.widget.SpeedWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_speed_info" />
        </receiver>

        <!-- Data-usage widget: what the speed widget cannot show, since speed is already
             permanently in the status bar. -->
        <receiver
            android:name=".data.widget.UsageWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_usage_info" />
        </receiver>

        <!-- Quick Settings tile toggling monitoring. -->
        <service
            android:name=".data.tile.SpeedTileService"
            android:exported="true"
            android:icon="@drawable/ic_speed_notification_bg"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Restores monitoring after a reboot or an app update. Exported so the system can
             deliver BOOT_COMPLETED; the receiver itself only reads our own preferences. -->
        <receiver
            android:name=".data.receivers.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

