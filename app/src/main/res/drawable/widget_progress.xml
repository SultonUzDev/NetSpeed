<?xml version="1.0" encoding="utf-8"?>
<!--
    Explicit track and bar colours. The default horizontal ProgressBar takes the system accent,
    which is unrelated to this widget's fixed dark card and can land nearly invisible on it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="#FF4FC3F7" />
            </shape>
        </clip>
    </item>
</layer-list>
